# ==============================================================================
# HỆ THỐNG QUẢN LÝ VULNERABILITY & PATCH MANAGEMENT - CẤU HÌNH MÔI TRƯỜNG (.env)
# ==============================================================================
# Sao chép file này thành .env và điền các thông tin thực tế của hệ thống.
# LƯU Ý: Không commit file .env chứa mật khẩu thật lên Git repository.

# ------------------------------------------------------------------------------
# 1. WAZUH API CONFIGURATION (Công cụ phát hiện & Xác minh)
# ------------------------------------------------------------------------------
# Địa chỉ URL của Wazuh Manager API (Mặc định cổng 55000)
WAZUH_API_URL=https://192.168.1.100:55000

# Tài khoản Wazuh API (Mặc định thường là wazuh hoặc wazuh-wui, khuyến nghị tạo user riêng cho script)
WAZUH_API_USER=wazuh_api_user

# Mật khẩu tài khoản Wazuh API
WAZUH_API_PASSWORD=YourWazuhPasswordHere

# Bỏ qua xác thực chứng chỉ SSL nếu dùng self-signed cert trên Wazuh (true / false)
WAZUH_VERIFY_SSL=false

# ------------------------------------------------------------------------------
# 2. WSUS SERVER CONFIGURATION (Kênh phân phối bản vá Microsoft)
# ------------------------------------------------------------------------------
# Địa chỉ FQDN hoặc IP của máy chủ WSUS
WSUS_SERVER_FQDN=wsus.corp.local

# Cổng dịch vụ WSUS (8530 cho HTTP thông thường, 8531 cho HTTPS)
WSUS_PORT=8530

# Sử dụng SSL khi kết nối WSUS (true / false)
WSUS_USE_SSL=false

# Nếu WSUS KHÔNG JOIN DOMAIN (Workgroup / Standalone Server), điền tài khoản Local Administrator trên máy chủ WSUS:
# Định dạng: WSUS-HOSTNAME\local_user hoặc .\local_user
WSUS_USER=
WSUS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. WINDOWS SERVER / ACTIVE DIRECTORY / WINRM (Xác thực node & kiểm tra build)
# ------------------------------------------------------------------------------
# Tên miền Active Directory
AD_DOMAIN=CORP.LOCAL

# Tài khoản Service Account có quyền đọc Hotfix/WMI/WinRM từ xa trên các máy chủ
WINRM_USER=svc_patch_auditor

# Mật khẩu tài khoản Service Account
WINRM_PASSWORD=YourServiceAccountPasswordHere

# ------------------------------------------------------------------------------
# 4. MICROSOFT SECURITY API & ONLINE MAPPING (Tùy chọn)
# ------------------------------------------------------------------------------
# API Key của Microsoft Security Response Center (MSRC) nếu muốn tự động tra cứu CVE -> KB online
# Có thể đăng ký tại: https://portal.msrc.microsoft.com/en-us/developer
MSRC_API_KEY=

# ------------------------------------------------------------------------------
# 5. SLA & THRESHOLDS CONFIGURATION (Theo PLAN.md)
# ------------------------------------------------------------------------------
# SLA giải quyết lỗ hổng theo độ ưu tiên
SLA_P1_CRITICAL_HOURS=72
SLA_P2_HIGH_DAYS=14
SLA_P3_MEDIUM_DAYS=30
SLA_P4_LOW_DAYS=90

# Mục tiêu Compliance (%)
TARGET_COMPLIANCE_RATE=95.0
TARGET_CRITICAL_COMPLIANCE_RATE=98.0
MAX_FAILED_PATCH_RATE=2.0

# ------------------------------------------------------------------------------
# 6. ALERT & NOTIFICATIONS (Cảnh báo khẩn cấp P1 / SLA Breach)
# ------------------------------------------------------------------------------
# Webhook URL (Hỗ trợ Microsoft Teams Incoming Webhook, Slack, Discord hoặc Custom HTTP Webhook)
ALERT_WEBHOOK_URL=

# Loại Webhook (teams / slack / generic)
ALERT_WEBHOOK_TYPE=teams

# Bật/tắt cảnh báo qua Webhook (true / false)
ENABLE_ALERTS=false

# ------------------------------------------------------------------------------
# 7. PATHS & OUTPUT
# ------------------------------------------------------------------------------
# Thư mục lưu trữ báo cáo audit và export
REPORT_OUTPUT_DIR=./reports
LOG_OUTPUT_DIR=./logs
EXCEPTIONS_FILE=./config/exceptions.json

# ------------------------------------------------------------------------------
# 8. GOOGLE GEMINI AI ADVISOR (Hướng dẫn khắc phục lỗ hổng khi không có KB)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

